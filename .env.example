# Names only, never values (secrets live in Vercel and GitHub, see specs/db-testing-and-migrations.md).
# Local values come from `scripts/supabase-cli.sh status` (the CLI's local defaults, not secrets).

# Supabase (staging in Vercel Production and Preview; local Supabase in CI)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Vercel Production only (= the staging branch). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Business by host (D-062). Unset until DNS points here.
PLATFORM_DOMAIN=
APP_HOST=
DEMO_SITE_SLUG=kinigi-hills
