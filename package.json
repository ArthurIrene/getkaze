{
  "name": "getkaze",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "weight-check": "node scripts/weight-check.mjs",
    "e2e": "playwright test",
    "speed-check": "node scripts/speed-check.mjs",
    "db:check": "node scripts/check-migrations.mjs --self-test && node --no-warnings scripts/gen-demo-seed.mjs --check",
    "db:test": "scripts/supabase-cli.sh test db",
    "check:bundle": "node scripts/check-client-bundle.mjs",
    "db:seed:gen": "node --no-warnings scripts/gen-demo-seed.mjs",
    "check:build": "node scripts/check-build-independence.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "turbo": "2.11.10"
  }
}
